# BBH-Scanner — copia questo file in `.env` e riempi i valori.
#   cp .env.example .env  &&  $EDITOR .env
# Il `.env` viene caricato automaticamente da ogni comando `bbh` (niente più `export`).
# È già ignorato da git: NON verrà committato.

# --- HackerOne (Hacker API v1) ---
# ATTENZIONE: lo username è l'IDENTIFIER del token, non il tuo handle.
# Lo trovi su https://hackerone.com/settings/api_token
HACKERONE_API_USERNAME=
HACKERONE_API_TOKEN=

# --- Telegram (opzionale: notifiche) ---
# Bot da @BotFather; chat id da @userinfobot.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- Scan attivo nuclei (opt-in) ---
# BBH_ACTIVE_SCAN=1
# BBH_NUCLEI_SEVERITY=medium,high,critical

# --- Governor termico (default tarati per Ryzen 7 5700U + RTX 3050) ---
# BBH_CPU_HOT=82
# BBH_CPU_CRITICAL=90
# BBH_GPU_HOT=85
# BBH_GPU_CRITICAL=92

# --- Intervalli (secondi) ---
# BBH_SYNC_INTERVAL=21600
# BBH_RECON_INTERVAL=86400
